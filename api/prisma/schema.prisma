// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------- USER -------------------
model User {
  id        Int       @id @default(autoincrement())
  nome      String
  cargo     String
  email     String    @unique
  senhaHash String
  
  tarefas   Tarefa[]       
  projetoUsuarios ProjetoUsuarios[] // referência à tabela intermediária

  @@map("users")
}

// ------------------- PROJETO -------------------
model Projeto {
  id            Int       @id @default(autoincrement())
  nome          String
  descricao     String
  dataInicio    DateTime
  dataFimPrevista DateTime
  statusId      Int
  status        Status    @relation(fields: [statusId], references: [id])
  
  tarefas       Tarefa[]  
  projetoUsuarios ProjetoUsuarios[] // referência à tabela intermediária

  @@map("projetos")
}

// ------------------- PROJETO-USUARIOS (intermediário) -------------------
model ProjetoUsuarios {
  projetoId Int
  userId    Int

  // CORRIGIDO: Adicionando onDelete: Cascade
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade) 
  usuario   User    @relation(fields: [userId], references: [id]) // Não precisa de Cascade aqui

  @@id([projetoId, userId])
  @@map("projeto_usuarios")
}

// ------------------- STATUS -------------------
model Status {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  projetos Projeto[]

  @@map("status")
}

// ------------------- STATUS TAREFA -------------------
model StatusTarefa {
  id      Int      @id @default(autoincrement())
  nome    String   @unique
  tarefas Tarefa[]

  @@map("status_tarefa")
}

// ------------------- TAREFA -------------------
model Tarefa {
  id            Int       @id @default(autoincrement())
  titulo        String
  descricao     String?   // Opcional
  prazo         DateTime? // Opcional
  concluida     Boolean   @default(false)

  // Relacionamento com o projeto
  projetoId     Int
  projeto       Projeto   @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  // Relacionamento com o usuário (assignee)
  assigneeId    Int?
  assignee      User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  // Relacionamento com o status da tarefa
  statusTarefaId Int
  statusTarefa  StatusTarefa @relation(fields: [statusTarefaId], references: [id])

  @@map("tarefas")
}
